begin model

begin parameters
  kf 0.1
  kr 0.1 
end parameters

begin species
  L(r) 200
  R(l)  100
end species

begin observables
    Molecules L_free L(r)
    Molecules R_free R(l)
    Molecules LR_complex L(r!1).R(l!1)
end observables

begin reaction rules
    L(r) + R(l) <-> L(r!1).R(l!1) kf, kr    
end reaction rules

end model

generate_network({overwrite=>1})
simulate({method=>"ode",t_end=>100, n_steps=>1000})
