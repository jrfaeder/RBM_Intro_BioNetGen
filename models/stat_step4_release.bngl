# Cytokine-STAT-SOCS signaling: Step 4: activated STAT dissociates from the receptor
# Cumulative model: includes steps 1-4. Lines marked '# new' were added in this step.
# Species have no internal structure here; molecule structure is introduced in Module 2.
# Units are illustrative: concentrations in uM, time in minutes.

begin model

begin parameters
  L0        10     # ligand (uM)
  R0        1      # receptor (uM)
  kon       1      # binding (1/uM/min)
  koff      0.1    # unbinding (1/min)
  S0        10     # STAT (uM)
  kSon      1      # STAT binding (1/uM/min)
  kSoff     1      # STAT unbinding (1/min)
  kact      1      # STAT activation (1/min)
  kdiss     1      # new: pSTAT release (1/min)
  kdephos   0.1    # new: pSTAT dephosphorylation (1/min)
end parameters

begin molecule types
  L
  R
  LR
  S
  LRS
  LRSp
  Sp  # new
end molecule types

begin species
  L    L0
  R    R0
  S    S0
end species

begin observables
  Molecules Lfree   L
  Molecules Rfree   R
  Molecules LR      LR
  Molecules Sfree   S
  Molecules LRS     LRS
  Molecules LRSp    LRSp
  Molecules Sp      Sp  # new
  Molecules pSTAT   LRSp Sp  # new
end observables

begin reaction rules
  # Ligand binds receptor
  LRbind: L + R <-> LR kon, koff
  # STAT binds ligand-bound receptor
  Sbind: LR + S <-> LRS kSon, kSoff
  # Receptor-associated kinase activates STAT
  Sact: LRS -> LRSp kact
  # Activated STAT dissociates (new)
  Srelease: LRSp -> LR + Sp kdiss
  # Phosphatase deactivates free STAT (new)
  Sdephos: Sp -> S kdephos
end reaction rules

end model

generate_network({overwrite=>1})
simulate({method=>"ode",t_end=>30,n_steps=>300})
